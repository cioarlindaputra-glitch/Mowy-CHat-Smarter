# === Mowy CS AI - contoh konfigurasi ===
# Salin file ini jadi .env lalu isi nilainya.

# Kunci OpenAI (otak jawaban Mowy). Ambil di https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model OpenAI. Default hemat & cukup pintar.
OPENAI_MODEL=gpt-4o-mini

# Koneksi database PostgreSQL dari Render.
# Render > database Anda > "External Database URL" (untuk dari lokal)
# atau "Internal Database URL" (kalau app jalan di Render juga).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Port server (Render mengisi ini otomatis saat deploy).
PORT=3000
